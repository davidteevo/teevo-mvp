# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App environment: development | staging | production
# Local: development. Staging Netlify: staging. Production Netlify: production.
NEXT_PUBLIC_APP_ENV=development

# App URL (for Stripe redirects, auth emails, absolute links)
# Local: http://localhost:3000
# Staging: https://test.teevohq.com
# Production: https://app.teevohq.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (local/staging: test keys sk_test_ / pk_test_; production: live keys)
STRIPE_SECRET_KEY=sk_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Shippo (shipping labels)
# Local/staging: shippo_test_...  Production: shippo_live_...
SHIPPO_API_TOKEN=shippo_test_...
# Optional: DPD UK carrier account object ID from Shippo (Settings → Carriers). Use if "no shipping rates" in test mode.
SHIPPO_DPD_CARRIER_ACCOUNT_ID=f2635d1716fb47aab349d6b91cc9c821

# Resend (auth emails: signup + forgot password; also transactional emails)
RESEND_API_KEY=re_...
# Optional override; default is Teevo <hello@teevohq.com>
# RESEND_FROM=Teevo <hello@teevohq.com>

# Supabase Auth Send Email hook (use Resend instead of Supabase SMTP)
# From Dashboard → Auth → Hooks → Send Email → secret (format: v1,whsec_<base64>)
SEND_EMAIL_HOOK_SECRET=v1,whsec_...

# Admin (packaging, feedback – comma-separated). Set the real address in .env.local (this file is only a template; the app does not load it).
TEEVO_ADMIN_EMAILS=admin@teevohq.com

# Production only (app + admin subdomain sharing). Do NOT set on staging or local.
# NEXT_PUBLIC_ADMIN_DOMAIN=admin.teevohq.com
# NEXT_PUBLIC_COOKIE_DOMAIN=.teevohq.com

# Seller onboarding: book-a-call link (optional)
# Booking Link (Teevo Seller Feedback Booking Link)
NEXT_PUBLIC_BOOK_CALL_URL=https://calendar.app.google/84fuiARU1YNdpcPm8

# AI (Phase 1: search intent, listing enhancement). Server-side only; never expose to client.
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# HMAC secret for seller availability confirmation links (email, no login).
# Falls back to CRON_SECRET or SUPABASE_SERVICE_ROLE_KEY if unset.
# AVAILABILITY_TOKEN_SECRET=generate-a-long-random-string
